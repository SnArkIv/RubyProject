<% content_for :title, "Редактирование профиля — Магазин" %>

<h1 class="mt-0">Редактирование профиля</h1>

<div class="max-w-[480px]">
  <% if @user.errors.any? %>
    <div class="bg-[#f8d7da] text-[#721c24] px-4 py-3 rounded mb-4">
      <ul class="list-disc pl-5 m-0">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: profile_path, method: :patch, local: true do |f| %>
    <div class="mb-4">
      <%= f.label :first_name, "Имя", class: "block mb-1 font-medium" %>
      <%= f.text_field :first_name, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
    </div>

    <div class="mb-4">
      <%= f.label :last_name, "Фамилия", class: "block mb-1 font-medium" %>
      <%= f.text_field :last_name, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
    </div>

    <div class="mb-4">
      <%= f.label :phone, "Телефон", class: "block mb-1 font-medium" %>
      <%= f.phone_field :phone, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
    </div>

    <div class="mb-4">
      <%= f.label :email, "Email", class: "block mb-1 font-medium" %>
      <%= f.email_field :email, required: true, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
    </div>

    <div class="mb-4" data-controller="password-toggle">
      <%= f.label :current_password, "Текущий пароль", class: "block mb-1 font-medium" %>
      <div class="relative">
        <%= f.password_field :current_password, class: "w-full px-3 py-2 rounded border border-[#999] bg-white pr-10", data: { password_toggle_target: "input" } %>
        <button type="button" data-action="click->password-toggle#toggle" class="absolute right-2 top-1/2 -translate-y-1/2 bg-transparent border-none cursor-pointer text-[#888]">👁</button>
      </div>
      <p class="text-xs text-[#888] mt-1">Обязателен для смены пароля</p>
    </div>

    <div class="mb-4" data-controller="password-toggle">
      <%= f.label :password, "Новый пароль", class: "block mb-1 font-medium" %>
      <div class="relative">
        <%= f.password_field :password, class: "w-full px-3 py-2 rounded border border-[#999] bg-white pr-10", data: { password_toggle_target: "input" } %>
        <button type="button" data-action="click->password-toggle#toggle" class="absolute right-2 top-1/2 -translate-y-1/2 bg-transparent border-none cursor-pointer text-[#888]">👁</button>
      </div>
      <p class="text-xs text-[#888] mt-1">Оставьте пустым, если не хотите менять</p>
    </div>

    <div class="mb-4" data-controller="password-toggle">
      <%= f.label :password_confirmation, "Подтверждение пароля", class: "block mb-1 font-medium" %>
      <div class="relative">
        <%= f.password_field :password_confirmation, class: "w-full px-3 py-2 rounded border border-[#999] bg-white pr-10", data: { password_toggle_target: "input" } %>
        <button type="button" data-action="click->password-toggle#toggle" class="absolute right-2 top-1/2 -translate-y-1/2 bg-transparent border-none cursor-pointer text-[#888]">👁</button>
      </div>
    </div>

    <div class="flex gap-3 items-center">
      <%= f.submit "Сохранить", class: "bg-accent text-white px-5 py-2 rounded-md cursor-pointer font-semibold border-none hover:brightness-105" %>
      <%= link_to "Отмена", profile_path, class: "text-text no-underline hover:underline" %>
    </div>
  <% end %>
</div>