<% content_for :title, "Личный кабинет — Магазин" %>

<h1 class="mt-0 text-2xl md:text-3xl">Личный кабинет</h1>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
  <div class="bg-white rounded-lg p-4 md:p-5 shadow-[0_2px_8px_rgba(0,0,0,0.06)]">
    <h2 class="mt-0 mb-4 text-lg md:text-xl">Данные пользователя</h2>
    <p class="mb-1 text-sm md:text-base"><strong>Email:</strong> <%= @user.email %></p>
    <p class="mb-1 text-sm md:text-base"><strong>Имя:</strong> <%= @user.first_name.presence || "—" %></p>
    <p class="mb-1 text-sm md:text-base"><strong>Фамилия:</strong> <%= @user.last_name.presence || "—" %></p>
    <p class="mb-1 text-sm md:text-base"><strong>Телефон:</strong> <%= @user.phone.presence || "—" %></p>
    <p class="mb-4 text-xs md:text-sm text-[#888]">Зарегистрирован: <%= l(@user.created_at, format: :short) %></p>
    <%= link_to "Редактировать профиль", edit_profile_path,
                class: "inline-block bg-accent text-white px-4 py-2 rounded-md no-underline font-semibold hover:brightness-105 text-sm md:text-base" %>
    <%= link_to "Адреса доставки", addresses_path,
        class: "inline-block mt-3 text-sm text-accent no-underline hover:underline" %>
  </div>

  <div class="bg-white rounded-lg p-4 md:p-5 shadow-[0_2px_8px_rgba(0,0,0,0.06)]">
    <h2 class="mt-0 mb-4 text-lg md:text-xl">История заказов</h2>
    <% if @orders.any? %>
      <div class="space-y-3 md:space-y-4">
        <% @orders.each do |order| %>
          <div class="border border-[#eee] rounded-lg p-3 md:p-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-2">
              <div>
                <span class="font-semibold text-sm md:text-base">Заказ №<%= order.id %></span>
                <span class="text-xs md:text-sm text-[#888] ml-2"><%= l(order.created_at, format: :short) %></span>
              </div>
              <div class="flex items-center gap-2 md:gap-3">
                <span class="text-xs md:text-sm px-2 py-0.5 rounded bg-page"><%= t("order.status.#{order.status}") %></span>
                <span class="font-bold text-sm md:text-base"><%= format("%.0f", order.total_amount) %> ₽</span>
              </div>
            </div>
            <div class="text-xs md:text-sm text-[#888] space-y-1 mb-2">
              <p class="m-0"><strong>Доставка:</strong> <%= order.delivery_method_label %> | <strong>Оплата:</strong> <%= order.payment_method_label %></p>
              <p class="m-0"><strong>Адрес:</strong> <%= order.shipping_address %></p>
              <% if order.order_items.any? %>
                <p class="m-0"><strong>Товары:</strong>
                  <% order.order_items.each_with_index do |item, idx| %>
                    <%= item.product.name %><%= idx < order.order_items.size - 1 ? ", " : "" %>
                  <% end %>
                  (<%= order.order_items.sum(:quantity) %> шт.)
                </p>
              <% end %>
            </div>
            <%= link_to "Подробнее →", order_path(order), class: "text-accent no-underline text-sm hover:underline" %>
          </div>
        <% end %>
      </div>
      <%= link_to "Все заказы →", orders_path, class: "inline-block mt-4 text-accent no-underline hover:underline text-sm" %>
    <% else %>
      <p class="text-[#888]">У вас пока нет заказов.</p>
    <% end %>
  </div>

  <div class="bg-white rounded-lg p-4 md:p-5 shadow-[0_2px_8px_rgba(0,0,0,0.06)] md:col-span-2">
    <h2 class="mt-0 mb-4 text-lg md:text-xl">Оцените товары</h2>
    <% if @unreviewed_products.any? %>
      <div class="grid grid-cols-2 sm:grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-3 md:gap-5">
        <% @unreviewed_products.each do |product| %>
          <%= render "catalog/product_card", product: product, query: {} %>
        <% end %>
      </div>
    <% else %>
      <p class="text-[#888] text-sm">Все товары оценены</p>
    <% end %>
  </div>
</div>
