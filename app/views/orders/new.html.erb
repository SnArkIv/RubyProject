<% content_for :title, "Оформление заказа — Магазин" %>

<h1 class="mt-0">Оформление заказа</h1>

<div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-6 items-start">
  <div class="bg-white rounded-lg p-5 shadow-[0_2px_8px_rgba(0,0,0,0.06)]">
    <h2 class="mt-0 mb-4">Адрес и доставка</h2>

    <% if @order&.errors&.any? %>
      <div class="bg-[#f8d7da] text-[#721c24] px-4 py-3 rounded mb-4">
        <ul class="list-disc pl-5 m-0">
          <% @order.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @order, url: orders_path, local: true, data: { controller: "auto-submit" } do |f| %>
      <div class="mb-4" id="address-field">
        <%= f.label :shipping_address, "Адрес доставки", class: "block mb-1 font-medium" %>
        <% if @addresses.any? %>
          <div class="space-y-2 mb-3">
            <% @addresses.each do |addr| %>
              <label class="flex items-start gap-2 text-sm cursor-pointer border border-[#eee] rounded p-2 hover:bg-page">
                <%= radio_button_tag :address_preset, addr.id, addr.is_default?, class: "accent-accent mt-0.5", data: { address: [ addr.city, addr.street, addr.house, addr.apartment, addr.zip_code ].compact.join(", ") } %>
                <div>
                  <div><%= addr.full_name %> | <%= addr.phone %></div>
                  <div class="text-[#888]"><%= addr.city %>, <%= addr.street %> <%= addr.house %>, кв. <%= addr.apartment %>, <%= addr.zip_code %></div>
                </div>
              </label>
            <% end %>
          </div>
        <% end %>
        <%= f.text_area :shipping_address, rows: 4,
            class: "w-full px-3 py-2 rounded border border-[#999] bg-white",
            placeholder: "Город, улица, дом, квартира, индекс" %>
      </div>

      <div class="mb-4">
        <%= f.label :delivery_method, "Способ доставки", class: "block mb-1 font-medium" %>
        <%= f.select :delivery_method,
            options_for_select(Order::DELIVERY_METHODS.map { |k, v| [ v, k ] }),
            {}, class: "w-full px-3 py-2 rounded border border-[#999] bg-white",
            data: { action: "change->auto-submit#toggleAddress" } %>
      </div>

      <div class="mb-4">
        <%= f.label :payment_method, "Способ оплаты", class: "block mb-1 font-medium" %>
        <%= f.select :payment_method,
            options_for_select(Order::PAYMENT_METHODS.map { |k, v| [ v, k ] }),
            {}, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
      </div>

      <div class="flex gap-3 items-center">
        <%= f.submit "Подтвердить заказ", class: "bg-accent text-white px-5 py-2 rounded-md cursor-pointer font-semibold border-none hover:brightness-105" %>
        <%= link_to "Вернуться в корзину", cart_path, class: "text-text no-underline hover:underline" %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg p-5 shadow-[0_2px_8px_rgba(0,0,0,0.06)]">
    <h3 class="mt-0 mb-3">Ваш заказ</h3>
    <ul class="list-none m-0 p-0 space-y-2">
      <% @cart_items.each do |item| %>
        <li class="flex justify-between text-sm">
          <span><%= item.product.name %> (<%= item.size %>) × <%= item.quantity %></span>
          <span class="font-medium"><%= format("%.0f", item.product.final_price * item.quantity) %> ₽</span>
        </li>
      <% end %>
    </ul>
    <div class="border-t border-[#eee] mt-3 pt-3 flex justify-between font-bold text-lg">
      <span>Итого:</span>
      <span><%= format("%.0f", @cart.total_amount) %> ₽</span>
    </div>
  </div>
</div>
