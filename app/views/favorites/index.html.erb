<% content_for :title, "Избранное — Магазин" %>

<h1 class="mt-0 text-2xl md:text-3xl">Избранное</h1>

<% if @favorites.any? %>
  <div class="grid grid-cols-2 sm:grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-3 sm:gap-5">
    <% @favorites.each do |favorite| %>
      <% product = favorite.product %>
      <div class="relative">
        <%= render "catalog/product_card", product: product, query: {} %>
        <%= button_to favorite_path(product), method: :delete,
            class: "absolute top-2 right-2 bg-white/90 text-accent border-none rounded-full w-7 h-7 md:w-8 md:h-8 flex items-center justify-center cursor-pointer shadow hover:bg-white text-sm md:text-base" do %>
          ✕
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-lg p-8 text-center shadow-[0_2px_8px_rgba(0,0,0,0.06)]">
    <p class="text-[#888] mb-4">У вас пока нет избранных товаров.</p>
    <%= link_to "Перейти в каталог", catalog_path,
        class: "inline-block bg-accent text-white px-6 py-3 rounded-md no-underline font-semibold hover:brightness-105" %>
  </div>
<% end %>
