<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      body { font-family: Arial, sans-serif; color: #333; }
      .container { max-width: 600px; margin: 0 auto; }
      .header { background: #1f1f1f; color: #fff; padding: 20px; text-align: center; }
      .content { padding: 20px; background: #fff; }
      .footer { padding: 20px; text-align: center; font-size: 12px; color: #888; }
      table { width: 100%; border-collapse: collapse; margin-top: 10px; }
      th, td { text-align: left; padding: 8px; border-bottom: 1px solid #eee; }
      th { background: #f5f5f5; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Новый заказ</h1>
      </div>
      <div class="content">
        <p>Поступил новый заказ №<%= @order.id %>.</p>
        <p><strong>Покупатель:</strong> <%= @order.user.email %></p>
        <p><strong>Сумма:</strong> <%= number_to_currency(@order.total_amount, unit: "₽", format: "%n %u") %></p>
        <p><strong>Адрес доставки:</strong> <%= @order.shipping_address %></p>
        <p><strong>Доставка:</strong> <%= @order.delivery_method_label %></p>
        <p><strong>Оплата:</strong> <%= @order.payment_method_label %></p>

        <table>
          <thead>
            <tr>
              <th>Товар</th>
              <th>Размер</th>
              <th>Кол-во</th>
              <th>Цена</th>
            </tr>
          </thead>
          <tbody>
            <% @order_items.each do |item| %>
              <tr>
                <td><%= item.product.name %></td>
                <td><%= item.size %></td>
                <td><%= item.quantity %></td>
                <td><%= number_to_currency(item.price, unit: "₽", format: "%n %u") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </body>
</html>
