<% content_for :title, "Каталог — Магазин" %>

<h1 class="mt-0">Распродажа</h1>

<div class="flex flex-wrap gap-3 items-center mb-5">
  <div class="relative group" tabindex="0">
    <button type="button"
            class="bg-[#e9c46a] text-[#1f1f1f] border-none px-4 py-2 rounded-md cursor-pointer font-semibold">Фильтр</button>
    <div class="hidden group-focus-within:block absolute top-full left-0 mt-1 bg-white border border-[#ccc] rounded-md py-2 min-w-[10rem] z-20 shadow-[0_4px_12px_rgba(0,0,0,0.12)]">
      <%= link_to "Все категории", catalog_path(@query.except(:category)),
                  class: "block px-4 py-1.5 no-underline hover:bg-page" %>
      <% Product::CATEGORIES.each do |slug, label| %>
        <%= link_to label, catalog_path(@query.merge(category: slug)),
                    class: "block px-4 py-1.5 no-underline hover:bg-page" %>
      <% end %>
    </div>
  </div>

  <%= form_with url: catalog_path, method: :get, local: true do %>
    <% @query.except(:gender).each do |k, v| %>
      <%= hidden_field_tag k, v if v.present? %>
    <% end %>
    <label>
      Пол:
      <%= select_tag :gender,
          options_for_select(
            [ [ "Все", "all" ], [ "М", "male" ], [ "Ж", "female" ] ],
            @query[:gender].presence || "all"
          ),
          class: "px-2.5 py-1.5 rounded border border-[#999] bg-white",
          onchange: "this.form.submit()" %>
    </label>
  <% end %>

  <%= form_with url: catalog_path, method: :get, local: true do %>
    <% @query.except(:sort).each do |k, v| %>
      <%= hidden_field_tag k, v if v.present? %>
    <% end %>
    <label>
      Сортировка:
      <%= select_tag :sort,
          options_for_select(
            [
              [ "По умолчанию", "" ],
              [ "Сначала дешевле", "price_asc" ],
              [ "Сначала дороже", "price_desc" ]
            ],
            @query[:sort]
          ),
          class: "px-2.5 py-1.5 rounded border border-[#999] bg-white",
          onchange: "this.form.submit()" %>
    </label>
  <% end %>
</div>

<div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-5">
  <% @products.each do |product| %>
    <%= render "catalog/product_card", product: product, query: @query %>
  <% end %>
</div>

<% if @products.empty? %>
  <p>Товаров не найдено.</p>
<% end %>

<%= turbo_frame_tag "product_modal" %>
