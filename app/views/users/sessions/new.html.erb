<% content_for :title, "Вход — Магазин" %>

<div class="max-w-[420px] mx-auto my-8 p-8 bg-cream rounded-lg shadow-[0_4px_20px_rgba(0,0,0,0.08)]">
  <h1>Вход</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div>
      <%= f.label :email, "Email", class: "block mt-4 font-medium" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
                        class: "w-full mt-1.5 px-2.5 py-2 border border-[#ccc] rounded" %>
    </div>

    <div class="mt-4">
      <%= f.label :password, "Пароль", class: "block mt-4 font-medium" %>
      <%= f.password_field :password, autocomplete: "current-password",
                           class: "w-full mt-1.5 px-2.5 py-2 border border-[#ccc] rounded" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="mt-3 flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded border-[#ccc]" %>
        <%= f.label :remember_me, "Запомнить меня", class: "text-sm" %>
      </div>
    <% end %>

    <p class="mt-4">
      <%= f.submit "Войти",
                   class: "inline-block bg-accent text-white px-6 py-3 rounded-md no-underline border-none cursor-pointer text-base font-semibold hover:brightness-105 w-full" %>
    </p>
  <% end %>

  <p class="mt-4 text-sm">
    <%= link_to "Нет аккаунта? Регистрация", new_registration_path(resource_name), class: "text-accent no-underline hover:underline" %>
  </p>
  <p class="mt-2 text-sm">
    <%= link_to "Забыли пароль?", new_password_path(resource_name), class: "text-accent no-underline hover:underline" %>
  </p>
</div>
