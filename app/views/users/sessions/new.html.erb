<% content_for :title, "Вход — Модница" %>

<div class="min-h-[60vh] flex items-center justify-center px-4">
  <div class="w-full max-w-[400px] mx-auto p-6 md:p-8 bg-white rounded-2xl shadow-lg">
    <div class="text-center mb-6">
      <svg class="mx-auto mb-3" width="40" height="40" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="32" height="32" rx="8" fill="#e63946"/>
        <path d="M16 6L10 12H13V20H10L16 26L22 20H19V12H22L16 6Z" fill="white"/>
      </svg>
      <h1 class="text-xl font-bold">Вход в аккаунт</h1>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-4">
        <%= f.label :email, "Email", class: "block text-sm font-medium mb-1.5 text-gray-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
                          class: "w-full px-3 py-2.5 border border-gray-200 rounded-lg bg-gray-50 focus:bg-white focus:border-[#e63946] focus:outline-none transition" %>
      </div>

      <div class="mb-4">
        <%= f.label :password, "Пароль", class: "block text-sm font-medium mb-1.5 text-gray-700" %>
        <%= f.password_field :password, autocomplete: "current-password",
                             class: "w-full px-3 py-2.5 border border-gray-200 rounded-lg bg-gray-50 focus:bg-white focus:border-[#e63946] focus:outline-none transition" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center justify-between mb-6">
          <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer">
            <%= f.check_box :remember_me, class: "rounded border-gray-300 text-[#e63946]" %>
            Запомнить меня
          </label>
          <%= link_to "Забыли пароль?", new_password_path(resource_name), class: "text-sm text-[#e63946] no-underline hover:underline" %>
        </div>
      <% end %>

      <%= f.submit "Войти",
                   class: "w-full bg-[#1a1a1a] text-white py-2.5 rounded-lg font-semibold cursor-pointer hover:bg-[#333] transition" %>
    <% end %>

    <p class="mt-6 text-center text-sm text-gray-500">
      Нет аккаунта? 
      <%= link_to "Зарегистрироваться", new_registration_path(resource_name), class: "text-[#e63946] font-medium no-underline hover:underline" %>
    </p>
  </div>
</div>
