<% content_for :title, "О нас — Магазин" %>

<!-- Hero -->
<section class="relative bg-dark text-on-dark rounded-lg overflow-hidden mb-8">
  <div class="p-8 md:p-16 text-center">
    <h1 class="mt-0 text-3xl md:text-4xl font-bold mb-4">Стильная одежда на каждый день</h1>
    <p class="text-lg text-white/80 mb-6">Качественные материалы, актуальные модели, честные цены</p>
    <%= link_to "Смотреть каталог", catalog_path,
        class: "inline-block bg-accent text-white px-8 py-3 rounded-md no-underline font-semibold hover:brightness-105" %>
  </div>
</section>

<!-- Popular categories -->
<section class="mb-8">
  <h2 class="mt-0 mb-4">Популярные категории</h2>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    <% @categories.each do |cat| %>
      <%= link_to catalog_path(category_id: cat.id),
          class: "group bg-white rounded-lg overflow-hidden shadow-[0_2px_8px_rgba(0,0,0,0.08)] no-underline text-inherit block" do %>
        <div class="bg-page p-6 text-center">
          <h3 class="mt-0 text-lg group-hover:text-accent transition-colors"><%= cat.name %></h3>
          <p class="text-sm text-[#888]"><%= cat.products.published.count %> товаров</p>
        </div>
      <% end %>
    <% end %>
  </div>
</section>

<!-- Sale block -->
<% if @sale_products.any? %>
  <section class="mb-8">
    <h2 class="mt-0 mb-4">Акции и скидки</h2>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-5">
      <% @sale_products.each do |product| %>
        <%= render "catalog/product_card", product: product, query: {} %>
      <% end %>
    </div>
    <div class="mt-4 text-center">
      <%= link_to "Все скидки", catalog_path(sort: "discount"), class: "text-accent no-underline hover:underline font-medium" %>
    </div>
  </section>
<% end %>

<section class="bg-[#fff3cd] border border-[#e9c46a] px-5 py-4 rounded-lg my-4">
  <strong>Акции и предложения:</strong> скидки на распродаже, бесплатная примерка при заказе от 5000 ₽, подарочный сертификат при покупке двух вещей.
</section>

<section class="my-8">
  <h2 class="mt-0">О бренде</h2>
  <p>Мы шьём одежду из натуральных тканей и следим за посадкой. Наша цель — вещи на каждый день, которые долго носятся и не устаревают за сезон.</p>
  <ul>
    <li>натуральные ткани и аккуратный крой;</li>
    <li>прозрачные условия возврата;</li>
    <li>собственное производство и контроль качества.</li>
  </ul>
</section>
