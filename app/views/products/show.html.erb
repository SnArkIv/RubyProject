<% content_for :title, "#{@product.name} — Магазин" %>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-6 md:mb-8">
  <!-- Gallery -->
  <div>
    <div class="bg-[#ddd] rounded-lg overflow-hidden aspect-square mb-3">
      <% if @product.images.attached? %>
        <%= active_storage_image_tag @product.images.first, resize_to_limit: [700, 700], alt: @product.name, class: "w-full h-full object-cover" %>
      <% else %>
        <%= image_tag "https://placehold.co/700x700/ddd/333?text=#{CGI.escape(@product.name)}", alt: @product.name, class: "w-full h-full object-cover" %>
      <% end %>
    </div>
    <% if @product.images.attached? && @product.images.count > 1 %>
      <div class="flex gap-2 overflow-x-auto pb-1">
        <% @product.images.each do |img| %>
          <div class="w-16 h-16 md:w-20 md:h-20 bg-[#ddd] rounded overflow-hidden shrink-0 cursor-pointer">
            <%= active_storage_image_tag img, resize_to_limit: [160, 160], alt: @product.name, class: "w-full h-full object-cover" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Info -->
  <div>
    <p class="text-xs md:text-sm text-[#888] mb-1">Артикул: <%= @product.sku %></p>
    <h1 class="mt-0 mb-2 text-xl md:text-3xl"><%= @product.name %></h1>
    <div class="flex items-center gap-2 mb-3 text-sm text-[#555]">
      <span><%= @product.category&.name %></span>
      <span>•</span>
      <span><%= @product.brand&.name %></span>
    </div>

    <div class="flex flex-wrap items-center gap-2 md:gap-3 mb-4">
      <% if @product.on_sale? %>
        <span class="line-through text-[#888] text-base md:text-lg"><%= @product.display_price %> ₽</span>
        <span class="inline-block bg-accent text-white px-3 md:px-4 py-1.5 md:py-2 rounded-md font-extrabold text-xl md:text-2xl"><%= @product.display_final_price %> ₽</span>
        <span class="bg-[#1f1f1f] text-white px-2 py-0.5 rounded text-xs md:text-sm">-<%= @product.discount %>%</span>
      <% else %>
        <span class="inline-block bg-accent text-white px-3 md:px-4 py-1.5 md:py-2 rounded-md font-extrabold text-xl md:text-2xl"><%= @product.display_price %> ₽</span>
      <% end %>
      <% if @product.average_rating.to_f > 0 %>
        <span class="text-xs md:text-sm">★ <%= @product.average_rating.round(1) %> (<%= @product.reviews.count %>)</span>
      <% end %>
    </div>

    <div class="space-y-2 text-sm text-[#555] mb-4">
      <p><strong>Цвет:</strong> <%= @product.color %></p>
      <p><strong>Материал:</strong> <%= @product.material %></p>
      <p><strong>Уход:</strong> <%= @product.care_instructions %></p>
      <p><strong>Наличие:</strong>
        <% if @product.stock_by_size.present? && @product.stock_by_size.any? %>
          <% available_sizes = @product.sizes.select { |sz| @product.in_stock_for_size?(sz) } %>
          <% if available_sizes.any? %>
            В наличии: <%= available_sizes.map { |sz| "#{sz} (#{@product.stock_for_size(sz)} шт.)" }.join(", ") %>
          <% else %>
            <span class="text-accent font-semibold">Нет в наличии</span>
          <% end %>
        <% elsif @product.low_stock? %>
          В наличии — осталось <%= @product.stock_quantity %> шт.
        <% elsif @product.in_stock? && @product.stock_quantity > 0 %>
          В наличии
        <% else %>
          <span class="text-accent font-semibold">Нет в наличии</span>
        <% end %>
      </p>
    </div>

    <% if @product.sizes.any? { |sz| @product.in_stock_for_size?(sz) } %>
      <%= form_with url: add_item_cart_path, method: :post, local: true, class: "mt-3" do %>
        <%= hidden_field_tag :product_id, @product.id %>
        <div class="mb-3">
          <label class="block mb-1 font-medium text-sm">Размер</label>
          <div class="flex flex-wrap gap-1.5">
            <% @product.sizes.each do |sz| %>
              <label class="cursor-pointer <%= 'opacity-30 pointer-events-none' unless @product.in_stock_for_size?(sz) %>">
                <%= radio_button_tag :size, sz, false, required: true, class: "sr-only peer", disabled: !@product.in_stock_for_size?(sz) %>
                <span class="inline-block px-3 py-[0.35rem] border border-[#333] bg-white rounded text-center text-[0.9rem] whitespace-nowrap peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent transition-colors hover:bg-accent/10 hover:text-accent"><%= sz %></span>
              </label>
            <% end %>
          </div>
        </div>
          <details class="mt-2">
            <summary class="text-xs text-[#888] cursor-pointer hover:text-accent">
              <% if @product.category&.name&.downcase&.include?("аксессуар") %>
                Руководство по размерам
              <% else %>
                Таблица размеров
              <% end %>
            </summary>
            <div class="mt-2 text-xs text-[#666] bg-[#f8f8f8] rounded p-2 overflow-x-auto">
              <% if @product.category&.name&.downcase&.include?("аксессуар") %>
                <table class="w-full text-left min-w-[260px]">
                  <thead><tr class="border-b border-[#ddd]"><th class="pr-2">Параметр</th><th>Значение</th></tr></thead>
                  <tbody>
                    <% @product.sizes.each do |sz| %>
                      <tr>
                        <td class="pr-2 font-medium">
                          <% if sz.include?("×") %>
                            <% if sz.split("×").size >= 3 %>Габариты (Д × Ш × В)<% else %>Габариты (Д × Ш)<% end %>
                          <% elsif sz.include?("см") && sz.include?("–") %>Обхват головы
                          <% else %>Размер
                          <% end %>
                        </td>
                        <td><%= sz %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              <% else %>
                <table class="w-full text-left min-w-[300px]">
                  <thead><tr class="border-b border-[#ddd]"><th class="pr-2">Размер</th><th class="pr-2">Обхват груди</th><th class="pr-2">Обхват талии</th><th>Обхват бёдер</th></tr></thead>
                  <tbody>
                    <tr><td class="pr-2">XS</td><td class="pr-2">82-86</td><td class="pr-2">62-66</td><td>88-92</td></tr>
                    <tr><td class="pr-2">S</td><td class="pr-2">86-90</td><td class="pr-2">66-70</td><td>92-96</td></tr>
                    <tr><td class="pr-2">M</td><td class="pr-2">90-94</td><td class="pr-2">70-74</td><td>96-100</td></tr>
                    <tr><td class="pr-2">L</td><td class="pr-2">94-100</td><td class="pr-2">74-80</td><td>100-106</td></tr>
                    <tr><td class="pr-2">XL</td><td class="pr-2">100-106</td><td class="pr-2">80-86</td><td>106-112</td></tr>
                  </tbody>
                </table>
              <% end %>
            </div>
          </details>
        <%= submit_tag "Добавить в корзину",
            class: "w-full bg-accent text-white px-4 py-3 rounded-md cursor-pointer font-semibold border-none hover:brightness-105 mt-4" %>
      <% end %>
    <% else %>
      <div class="mt-3">
        <div class="w-full bg-gray-300 text-gray-500 px-4 py-3 rounded-md font-semibold text-center cursor-not-allowed">Нет в наличии</div>
      </div>
    <% end %>

    <% if user_signed_in? %>
      <div class="mt-3">
        <% if @favorite %>
          <%= button_to "Удалить из избранного", favorite_path(@favorite), method: :delete,
              class: "w-full border border-accent text-accent px-4 py-2 rounded-md cursor-pointer font-semibold bg-transparent hover:bg-accent/5" %>
        <% else %>
          <%= button_to "В избранное", favorites_path(product_id: @product.id), method: :post,
              class: "w-full border border-[#333] text-[#333] px-4 py-2 rounded-md cursor-pointer font-semibold bg-transparent hover:bg-page" %>
        <% end %>
      </div>
    <% end %>

    <div class="mt-6">
      <h3 class="font-semibold mb-2 text-base">Описание</h3>
      <p class="text-sm text-[#555]"><%= simple_format(@product.description.presence || "Описание появится позже.") %></p>
    </div>
  </div>
</div>

<!-- Reviews -->
<div class="mb-6 md:mb-8">
  <h2 class="mt-0 mb-4 text-xl md:text-2xl">Отзывы</h2>
  <% if @reviews.any? %>
    <div class="space-y-3">
      <% @reviews.each do |review| %>
        <div class="bg-white rounded-lg p-4 shadow-[0_2px_8px_rgba(0,0,0,0.06)]">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
            <span class="font-medium text-sm"><%= review.user.email %></span>
            <span class="text-xs text-[#888]"><%= l(review.created_at, format: :short) %></span>
          </div>
          <div class="text-accent text-sm mb-1"><%= "★" * review.rating %><%= "☆" * (5 - review.rating) %></div>
          <p class="text-sm text-[#555] m-0"><%= review.comment %></p>
          <% if review.user == current_user %>
            <%= button_to "Удалить", review_path(review), method: :delete,
                class: "mt-2 text-xs text-accent bg-transparent border-none cursor-pointer hover:underline" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-[#888]">Пока нет отзывов.</p>
  <% end %>

  <% if user_signed_in? && current_user.orders.joins(:order_items).where(order_items: { product_id: @product.id }, status: :delivered).exists? %>
    <div class="mt-4 bg-white rounded-lg p-4 shadow-[0_2px_8px_rgba(0,0,0,0.06)]">
      <h3 class="mt-0 mb-2 text-base">Оставить отзыв</h3>
      <%= form_with model: @review, url: reviews_path(product_id: @product.id), local: true do |f| %>
        <div class="mb-3">
          <%= f.label :rating, "Оценка", class: "block mb-1 font-medium text-sm" %>
          <%= f.select :rating, (1..5).map { |r| [ "#{r} ★", r ] }, {}, class: "px-2 py-1.5 rounded border border-[#999] bg-white text-sm w-full sm:w-auto" %>
        </div>
        <div class="mb-3">
          <%= f.label :comment, "Комментарий", class: "block mb-1 font-medium text-sm" %>
          <%= f.text_area :comment, rows: 3, class: "w-full px-3 py-2 rounded border border-[#999] bg-white text-sm" %>
        </div>
        <%= f.submit "Отправить", class: "bg-accent text-white px-4 py-2 rounded-md cursor-pointer font-semibold border-none hover:brightness-105 w-full sm:w-auto" %>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Similar products -->
<% if @similar_products.any? %>
  <div class="mb-6 md:mb-8">
    <h2 class="mt-0 mb-4 text-xl md:text-2xl">Похожие товары</h2>
    <div class="grid grid-cols-2 sm:grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-3 sm:gap-5">
      <% @similar_products.each do |product| %>
        <%= render "catalog/product_card", product: product, query: {} %>
      <% end %>
    </div>
  </div>
<% end %>
