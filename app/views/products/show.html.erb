<% content_for :title, "#{@product.name} — Магазин" %>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
  <!-- Gallery -->
  <div>
    <div class="bg-[#ddd] rounded-lg overflow-hidden aspect-square mb-3">
      <% if @product.images.attached? %>
        <%= active_storage_image_tag @product.images.first, resize_to_limit: [ 700, 700 ], alt: @product.name, class: "w-full h-full object-cover" %>
      <% else %>
        <%= image_tag "https://placehold.co/700x700/ddd/333?text=#{CGI.escape(@product.name)}", alt: @product.name, class: "w-full h-full object-cover" %>
      <% end %>
    </div>
    <% if @product.images.attached? && @product.images.count > 1 %>
      <div class="flex gap-2 overflow-x-auto">
        <% @product.images.each do |img| %>
          <div class="w-20 h-20 bg-[#ddd] rounded overflow-hidden shrink-0 cursor-pointer">
            <%= active_storage_image_tag img, resize_to_limit: [ 160, 160 ], alt: @product.name, class: "w-full h-full object-cover" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Info -->
  <div>
    <p class="text-sm text-[#888] mb-1">Артикул: <%= @product.sku %></p>
    <h1 class="mt-0 mb-2"><%= @product.name %></h1>
    <div class="flex items-center gap-2 mb-3">
      <span class="text-sm"><%= @product.category&.name %></span>
      <span>•</span>
      <span class="text-sm"><%= @product.brand&.name %></span>
    </div>

    <div class="flex items-center gap-3 mb-4">
      <% if @product.on_sale? %>
        <span class="line-through text-[#888] text-lg"><%= @product.display_price %> ₽</span>
        <span class="inline-block bg-accent text-white px-4 py-2 rounded-md font-extrabold text-2xl"><%= @product.display_final_price %> ₽</span>
        <span class="bg-[#1f1f1f] text-white px-2 py-0.5 rounded text-sm">-<%= @product.discount %>%</span>
      <% else %>
        <span class="inline-block bg-accent text-white px-4 py-2 rounded-md font-extrabold text-2xl"><%= @product.display_price %> ₽</span>
      <% end %>
      <% if @product.average_rating.to_f > 0 %>
        <span class="text-sm">★ <%= @product.average_rating.round(1) %> (<%= @product.reviews.count %>)</span>
      <% end %>
    </div>

    <div class="space-y-2 text-sm text-[#555] mb-4">
      <p><strong>Цвет:</strong> <%= @product.color %></p>
      <p><strong>Материал:</strong> <%= @product.material %></p>
      <p><strong>Уход:</strong> <%= @product.care_instructions %></p>
      <p><strong>Наличие:</strong>
        <% unless @product.in_stock? %>
          Нет в наличии
        <% elsif @product.low_stock? %>
          В наличии — осталось <%= @product.stock_quantity %> шт.
        <% else %>
          В наличии
        <% end %>
      </p>
    </div>

    <%= form_with url: add_item_cart_path, method: :post, local: true, class: "mt-3" do %>
      <%= hidden_field_tag :product_id, @product.id %>
      <div class="mb-3">
        <label class="block mb-1 font-medium text-sm">Размер</label>
        <div class="flex flex-wrap gap-1.5">
          <% @product.sizes.each do |sz| %>
            <label class="cursor-pointer">
              <%= radio_button_tag :size, sz, false, required: true, class: "sr-only peer" %>
              <span class="inline-block min-w-9 px-2 py-[0.35rem] border border-[#333] bg-white rounded text-center text-[0.9rem] peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent transition-colors"><%= sz %></span>
            </label>
          <% end %>
        </div>
      </div>
      <%= submit_tag "Добавить в корзину",
          class: "w-full bg-accent text-white px-4 py-3 rounded-md cursor-pointer font-semibold border-none hover:brightness-105" %>
    <% end %>

    <% if user_signed_in? %>
      <div class="mt-3">
        <% if @favorite %>
          <%= button_to "Удалить из избранного", favorite_path(@favorite), method: :delete,
              class: "w-full border border-accent text-accent px-4 py-2 rounded-md cursor-pointer font-semibold bg-transparent hover:bg-accent/5" %>
        <% else %>
          <%= button_to "В избранное", favorites_path(product_id: @product.id), method: :post,
              class: "w-full border border-[#333] text-[#333] px-4 py-2 rounded-md cursor-pointer font-semibold bg-transparent hover:bg-page" %>
        <% end %>
      </div>
    <% end %>

    <div class="mt-6">
      <h3 class="font-semibold mb-2">Описание</h3>
      <p class="text-sm text-[#555]"><%= simple_format(@product.description.presence || "Описание появится позже.") %></p>
    </div>
  </div>
</div>

<!-- Reviews -->
<div class="mb-8">
  <h2 class="mt-0 mb-4">Отзывы</h2>
  <% if @reviews.any? %>
    <div class="space-y-3">
      <% @reviews.each do |review| %>
        <div class="bg-white rounded-lg p-4 shadow-[0_2px_8px_rgba(0,0,0,0.06)]">
          <div class="flex items-center justify-between mb-1">
            <span class="font-medium text-sm"><%= review.user.email %></span>
            <span class="text-xs text-[#888]"><%= l(review.created_at, format: :short) %></span>
          </div>
          <div class="text-accent text-sm mb-1"><%= "★" * review.rating %><%= "☆" * (5 - review.rating) %></div>
          <p class="text-sm text-[#555] m-0"><%= review.comment %></p>
          <% if review.user == current_user %>
            <%= button_to "Удалить", review_path(review), method: :delete,
                class: "mt-2 text-xs text-accent bg-transparent border-none cursor-pointer hover:underline" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-[#888]">Пока нет отзывов.</p>
  <% end %>

  <% if user_signed_in? && current_user.orders.joins(:order_items).where(order_items: { product_id: @product.id }).exists? %>
    <div class="mt-4 bg-white rounded-lg p-4 shadow-[0_2px_8px_rgba(0,0,0,0.06)]">
      <h3 class="mt-0 mb-2 text-base">Оставить отзыв</h3>
      <%= form_with model: @review, url: reviews_path(product_id: @product.id), local: true do |f| %>
        <div class="mb-3">
          <%= f.label :rating, "Оценка", class: "block mb-1 font-medium text-sm" %>
          <%= f.select :rating, (1..5).map { |r| [ "#{r} ★", r ] }, {}, class: "px-2 py-1.5 rounded border border-[#999] bg-white" %>
        </div>
        <div class="mb-3">
          <%= f.label :comment, "Комментарий", class: "block mb-1 font-medium text-sm" %>
          <%= f.text_area :comment, rows: 3, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
        </div>
        <%= f.submit "Отправить", class: "bg-accent text-white px-4 py-2 rounded-md cursor-pointer font-semibold border-none hover:brightness-105" %>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Similar products -->
<% if @similar_products.any? %>
  <div class="mb-8">
    <h2 class="mt-0 mb-4">Похожие товары</h2>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-5">
      <% @similar_products.each do |product| %>
        <%= render "catalog/product_card", product: product, query: {} %>
      <% end %>
    </div>
  </div>
<% end %>
