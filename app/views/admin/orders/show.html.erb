<h1 class="mt-0">Заказ №<%= @order.id %></h1>

<div class="grid grid-cols-1 md:grid-cols-[1fr_320px] gap-6 items-start">
  <div class="space-y-4">
    <% @order.order_items.each do |item| %>
      <div class="bg-white rounded-lg p-4 shadow-[0_2px_8px_rgba(0,0,0,0.06)] flex items-center gap-4">
        <% if item.product.images.attached? %>
          <%= image_tag url_for(item.product.images.first), class: "w-20 h-20 object-cover rounded" %>
        <% end %>
        <div class="flex-1">
          <h3 class="mt-0 mb-1 font-semibold"><%= item.product.name %></h3>
          <p class="text-sm text-[#888] m-0">Размер: <%= item.size %> | Количество: <%= item.quantity %></p>
          <p class="text-sm font-medium mt-1"><%= format("%.0f", item.price) %> ₽ за шт.</p>
        </div>
        <div class="font-bold"><%= format("%.0f", item.price * item.quantity) %> ₽</div>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg p-5 shadow-[0_2px_8px_rgba(0,0,0,0.06)]">
    <h3 class="mt-0 mb-3">Информация о заказе</h3>
    <div class="space-y-2 text-sm">
      <div class="flex justify-between"><span class="text-[#888]">Покупатель:</span><span><%= @order.user.email %></span></div>
      <div class="flex justify-between"><span class="text-[#888]">Статус:</span><span class="font-medium"><%= t("order.status.#{@order.status}") %></span></div>
      <div class="flex justify-between"><span class="text-[#888]">Дата:</span><span><%= l(@order.created_at, format: :long) %></span></div>
      <div class="flex justify-between"><span class="text-[#888]">Адрес:</span><span class="text-right max-w-[200px]"><%= @order.shipping_address %></span></div>
      <div class="flex justify-between"><span class="text-[#888]">Доставка:</span><span><%= @order.delivery_method_label %></span></div>
      <div class="flex justify-between"><span class="text-[#888]">Оплата:</span><span><%= @order.payment_method_label %></span></div>
    </div>
    <div class="border-t border-[#eee] mt-3 pt-3 flex justify-between font-bold text-lg">
      <span>Итого:</span>
      <span><%= format("%.0f", @order.total_amount) %> ₽</span>
    </div>
    <%= link_to "← Назад к заказам", admin_orders_path, class: "inline-block mt-4 text-accent no-underline hover:underline" %>
  </div>
</div>
