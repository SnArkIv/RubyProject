<h1 class="mt-0">Промокоды</h1>

<div class="mb-4">
  <%= link_to "+ Новый промокод", new_admin_promo_code_path, class: "inline-block bg-accent text-white px-4 py-2 rounded-md no-underline font-semibold hover:brightness-105" %>
</div>

<div class="bg-white rounded-lg shadow-[0_2px_8px_rgba(0,0,0,0.06)] overflow-hidden">
  <table class="w-full text-left border-collapse">
    <thead>
      <tr class="border-b border-[#eee]">
        <th class="p-3 font-semibold">Код</th>
        <th class="p-3 font-semibold">Скидка</th>
        <th class="p-3 font-semibold">Активен</th>
        <th class="p-3 font-semibold">Использован</th>
        <th class="p-3 font-semibold">Макс. использований</th>
        <th class="p-3 font-semibold">Действует до</th>
        <th class="p-3 font-semibold"></th>
      </tr>
    </thead>
    <tbody>
      <% @promo_codes.each do |pc| %>
        <tr class="border-b border-[#eee] last:border-b-0">
          <td class="p-3 font-mono"><%= pc.code %></td>
          <td class="p-3"><%= pc.discount %>%</td>
          <td class="p-3"><%= pc.active ? "Да" : "Нет" %></td>
          <td class="p-3"><%= pc.uses_count %><%= pc.max_uses ? " / #{pc.max_uses}" : "" %></td>
          <td class="p-3"><%= pc.max_uses || "∞" %></td>
          <td class="p-3 text-sm"><%= pc.expires_at ? l(pc.expires_at, format: :short) : "—" %></td>
          <td class="p-3">
            <%= link_to "Редактировать", edit_admin_promo_code_path(pc), class: "text-accent no-underline hover:underline text-sm" %>
            <%= button_to "Удалить", admin_promo_code_path(pc), method: :delete,
                class: "text-accent bg-transparent border-none cursor-pointer hover:underline text-sm", data: { turbo_confirm: "Удалить промокод?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @pagy.pages > 1 %>
    <div class="p-3 flex justify-center"><%= render "shared/pagination", pagy: @pagy %></div>
  <% end %>
</div>