<h1 class="mt-0">Бренды</h1>

<div class="mb-4">
  <%= link_to "+ Новый бренд", new_admin_brand_path, class: "inline-block bg-accent text-white px-4 py-2 rounded-md no-underline font-semibold hover:brightness-105" %>
</div>

<div class="bg-white rounded-lg shadow-[0_2px_8px_rgba(0,0,0,0.06)] overflow-hidden">
  <table class="w-full text-left border-collapse">
    <thead>
      <tr class="border-b border-[#eee]">
        <th class="p-3 font-semibold">ID</th>
        <th class="p-3 font-semibold">Название</th>
        <th class="p-3 font-semibold">Товаров</th>
        <th class="p-3 font-semibold"></th>
      </tr>
    </thead>
    <tbody>
      <% @brands.each do |brand| %>
        <tr class="border-b border-[#eee] last:border-b-0">
          <td class="p-3"><%= brand.id %></td>
          <td class="p-3"><%= brand.name %></td>
          <td class="p-3"><%= brand.products.count %></td>
          <td class="p-3">
            <%= link_to "Редактировать", edit_admin_brand_path(brand), class: "text-accent no-underline hover:underline text-sm" %>
            <%= button_to "Удалить", admin_brand_path(brand), method: :delete,
                class: "text-accent bg-transparent border-none cursor-pointer hover:underline text-sm", data: { turbo_confirm: "Удалить бренд?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
