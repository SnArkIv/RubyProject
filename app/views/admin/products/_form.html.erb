<%= form_with model: [:admin, product], url: url, method: method, local: true, multipart: true do |f| %>
  <% if product.errors.any? %>
    <div class="bg-[#f8d7da] text-[#721c24] px-4 py-3 rounded mb-4">
      <ul class="list-disc pl-5 m-0">
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-3">
    <div>
      <%= f.label :name, "Название", class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :name, required: true, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
    </div>
    <div>
      <%= f.label :sku, "Артикул", class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :sku, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :price, "Цена", class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :price, required: true, step: 0.01, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
      </div>
      <div>
        <%= f.label :discount, "Скидка %", class: "block text-sm font-medium mb-1" %>
        <%= f.number_field :discount, min: 0, max: 100, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :category_id, "Категория", class: "block text-sm font-medium mb-1" %>
        <%= f.collection_select :category_id, @categories, :id, :name, { include_blank: true }, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
      </div>
      <div>
        <%= f.label :brand_id, "Бренд", class: "block text-sm font-medium mb-1" %>
        <%= f.collection_select :brand_id, @brands, :id, :name, { include_blank: true }, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :status, "Статус", class: "block text-sm font-medium mb-1" %>
        <%= f.select :status, options_for_select([ [ "Черновик", "draft" ], [ "Опубликован", "published" ], [ "Архив", "archived" ] ], product.status),
            {}, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
      </div>
      <div>
        <%= f.label :gender, "Пол", class: "block text-sm font-medium mb-1" %>
        <%= f.select :gender, options_for_select(Product::GENDERS.map { |k, v| [ v, k ] }, product.gender),
            {}, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
      </div>
    </div>
    <div>
      <%= f.label :sizes, "Размеры", class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :sizes, value: product.sizes&.join(", "), placeholder: "S, M, L, XL",
          class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
      <p class="text-xs text-[#888]">Через запятую</p>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :color, "Цвет", class: "block text-sm font-medium mb-1" %>
        <%= f.text_field :color, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
      </div>
      <div>
        <%= f.label :material, "Материал", class: "block text-sm font-medium mb-1" %>
        <%= f.text_field :material, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
      </div>
    </div>
    <div>
      <%= f.label :description, "Описание", class: "block text-sm font-medium mb-1" %>
      <%= f.text_area :description, rows: 4, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
    </div>
    <div>
      <%= f.label :care_instructions, "Уход", class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :care_instructions, class: "w-full px-3 py-2 rounded border border-[#999] bg-white" %>
    </div>
    <label class="flex items-center gap-2 text-sm">
      <%= f.check_box :in_stock, class: "accent-accent" %>
      В наличии
    </label>
    <div>
      <%= f.label :images, "Изображения", class: "block text-sm font-medium mb-1" %>
      <%= f.file_field :images, multiple: true, accept: "image/*", class: "w-full" %>
      <% if product.images.attached? %>
        <div class="flex gap-2 mt-2">
          <% product.images.each do |img| %>
            <%= image_tag url_for(img), class: "w-16 h-16 object-cover rounded" %>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="flex gap-3 items-center pt-2">
      <%= f.submit "Сохранить", class: "bg-accent text-white px-4 py-2 rounded-md cursor-pointer font-semibold border-none hover:brightness-105" %>
      <%= link_to "Отмена", admin_products_path, class: "text-text no-underline hover:underline" %>
    </div>
  </div>
<% end %>
